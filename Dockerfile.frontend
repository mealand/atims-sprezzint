# ATiMs frontend image — builds the Vite app from the monorepo ROOT (so the
# @atims/shared workspace is available to the alias), then serves static
# files with nginx. Set VITE_API_URL to the API's public Railway domain.
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY api/package.json api/package.json
COPY verify/package.json verify/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci

COPY tsconfig.base.json ./
COPY shared/ shared/
COPY frontend/ frontend/

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app/frontend
RUN npx vite build

FROM nginx:alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
