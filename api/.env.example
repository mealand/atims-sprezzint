# ── ATiMs API environment ─────────────────────────────
# Copy to api/.env and adjust. NEVER commit api/.env.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://atims:atims@localhost:5432/atims
# CORS origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-to-openssl-rand-hex-32
JWT_EXPIRES_IN=12h
BCRYPT_OR_ARGON2_MEM_COST=65536
# First-run only: creates the initial admin if none exists (min 12 chars).
# Remove after the first successful migration.
ATIMS_ADMIN_PASSWORD=
ATIMS_ADMIN_NEXUS_ID=ATIMS-ADMIN-000001

# ── Email ─────────────────────────────────────────────
# Verification codes (api/src/services/email.ts).
# RESEND_API_KEY set:   codes are emailed through the Resend HTTP API.
# RESEND_API_KEY empty: nothing is sent. The code is logged and returned in the
#   API response as `verification.dev_code`. Dev and demo ONLY: anyone can
#   verify any email address in this mode.
# MUST be set in Railway variables before real users register.
# Never put a real key in this file (the repo is public).
RESEND_API_KEY=
# Sender address. Its domain must be verified in Resend.
EMAIL_FROM=ATiMs <no-reply@sprezzint.com>

# ── Integrity ─────────────────────────────────────────
# Server-side chain needs no key material; trusts client signatures.
CHAIN_STRICT=true

# ── AI (local Ollama) ─────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_RATE_LIMIT_PER_ENTITY_PER_DAY=100

# ⏱ OpenTimestamps anchoring (M5) — free Bitcoin-anchored proof-of-existence
OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org,https://a.pool.eternitywall.com,https://ots.btc.catallaxy.com
OTS_ANCHOR_INTERVAL_MS=300000
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=atims-minio
MINIO_SECRET_KEY=atims-minio-secret
MINIO_BUCKET=atims-evidence
