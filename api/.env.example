# ── ATiMs API environment ─────────────────────────────
# Copy to api/.env and adjust. NEVER commit api/.env.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://atims:atims@localhost:5432/atims
# CORS origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-to-openssl-rand-hex-32
JWT_EXPIRES_IN=12h
BCRYPT_OR_ARGON2_MEM_COST=65536

# ── Integrity ─────────────────────────────────────────
# Server-side chain needs no key material; trusts client signatures.
CHAIN_STRICT=true

# ── AI (local Ollama) ─────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_RATE_LIMIT_PER_ENTITY_PER_DAY=100

# ⏱ OpenTimestamps anchoring (M5) — free Bitcoin-anchored proof-of-existence
OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org,https://a.pool.eternitywall.com,https://ots.btc.catallaxy.com
OTS_ANCHOR_INTERVAL_MS=300000
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=atims-minio
MINIO_SECRET_KEY=atims-minio-secret
MINIO_BUCKET=atims-evidence
